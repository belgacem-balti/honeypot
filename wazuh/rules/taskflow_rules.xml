<!--
  TaskFlow custom rules (mounted in /var/ossec/etc/rules/). IDs 100100-100199.
  Input: JSON log lines from the server, format in wazuh/README.md.
  Fields used: app, type, event, method, path, query, body, http_status, srcip, email.
  "srcip" keeps its Wazuh static name so same_source_ip works.

  MITRE ATT&CK mapping
    100110-100112  SQL injection          T1190 Exploit Public-Facing Application
    100120-100121  XSS                    T1189 Drive-by Compromise, T1059.007 JavaScript
    100130         failed login           T1110 Brute Force
    100131         brute force            T1110.001 Password Guessing
    100140         /api/debug             T1082 System Information Discovery
    100141         /api/config            T1552 Unsecured Credentials
    100142-100143  /api/backup/users      T1213 Data from Information Repositories
    100145         sensitive route sweep  T1595.003 Wordlist Scanning
-->
<group name="taskflow,web,">

  <!-- Base rule: any TaskFlow server event -->
  <rule id="100100" level="0">
    <field name="app">^taskflow-server$</field>
    <description>TaskFlow server event</description>
  </rule>

  <!-- SQL injection (GET /api/search?q=, GET /api/admin/search?q=) -->
  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="query" type="pcre2">(?i)(\bunion\b.{0,40}\bselect\b|'\s*(or|and)\s+'?\w+'?\s*=\s*'?\w+|\bor\b\s+\d+\s*=\s*\d+|;\s*(drop|delete|update|insert|alter)\b|\bpg_sleep\s*\(|\bsleep\s*\(|\binformation_schema\b|\bpg_catalog\b|'\s*--|/\*.*\*/)</field>
    <description>TaskFlow: SQL injection attempt in query string ($(path))</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <rule id="100111" level="10">
    <if_sid>100100</if_sid>
    <field name="body" type="pcre2">(?i)(\bunion\b.{0,40}\bselect\b|'\s*(or|and)\s+'?\w+'?\s*=\s*'?\w+|\bor\b\s+\d+\s*=\s*\d+|;\s*(drop|delete|update|insert|alter)\b|\bpg_sleep\s*\(|\binformation_schema\b)</field>
    <description>TaskFlow: SQL injection attempt in request body ($(path))</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <!-- The vulnerable routes return the database error on 500: error-based injection -->
  <rule id="100112" level="12">
    <if_sid>100110</if_sid>
    <field name="http_status">^500$</field>
    <description>TaskFlow: SQL injection caused a database error (error-based injection likely)</description>
    <mitre>
      <id>T1190</id>
    </mitre>
    <group>attack,sql_injection,</group>
  </rule>

  <!-- XSS: reflected in the query string, or stored through task title/description -->
  <rule id="100120" level="8">
    <if_sid>100100</if_sid>
    <field name="query" type="pcre2">(?i)(\x3c\s*/?\s*script|javascript\s*:|\bon(error|load|mouseover|focus|click)\s*=|\x3c\s*(iframe|svg|img|object|embed)\b|document\.cookie|%3Cscript)</field>
    <description>TaskFlow: XSS payload in query string ($(path))</description>
    <mitre>
      <id>T1189</id>
      <id>T1059.007</id>
    </mitre>
    <group>attack,xss,</group>
  </rule>

  <rule id="100121" level="10">
    <if_sid>100100</if_sid>
    <field name="body" type="pcre2">(?i)(\x3c\s*/?\s*script|javascript\s*:|\bon(error|load|mouseover|focus|click)\s*=|\x3c\s*(iframe|svg|img|object|embed)\b|document\.cookie)</field>
    <description>TaskFlow: stored XSS payload in request body ($(method) $(path))</description>
    <mitre>
      <id>T1189</id>
      <id>T1059.007</id>
    </mitre>
    <group>attack,xss,</group>
  </rule>

  <!-- Authentication -->
  <rule id="100130" level="5">
    <if_sid>100100</if_sid>
    <field name="type">^auth$</field>
    <field name="event">^login_failed$</field>
    <description>TaskFlow: failed login for $(email)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100131" level="10" frequency="8" timeframe="120">
    <if_matched_sid>100130</if_matched_sid>
    <same_source_ip />
    <description>TaskFlow: brute force, 8 failed logins in 120s from the same IP</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,attack,</group>
  </rule>

  <!-- Sensitive routes exposed by the honeypot -->
  <rule id="100140" level="8">
    <if_sid>100100</if_sid>
    <field name="path">^/api/debug</field>
    <description>TaskFlow: access to debug endpoint /api/debug</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>attack,sensitive_route,</group>
  </rule>

  <rule id="100141" level="10">
    <if_sid>100100</if_sid>
    <field name="path">^/api/config</field>
    <description>TaskFlow: access to configuration endpoint /api/config</description>
    <mitre>
      <id>T1552</id>
    </mitre>
    <group>attack,sensitive_route,</group>
  </rule>

  <rule id="100142" level="10">
    <if_sid>100100</if_sid>
    <field name="path">^/api/backup/users</field>
    <description>TaskFlow: access to user backup endpoint /api/backup/users</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>attack,sensitive_route,</group>
  </rule>

  <rule id="100143" level="12">
    <if_sid>100142</if_sid>
    <field name="http_status">^200$</field>
    <description>TaskFlow: user backup downloaded (users and password hashes exposed)</description>
    <mitre>
      <id>T1213</id>
    </mitre>
    <group>attack,sensitive_route,data_exposure,</group>
  </rule>

  <rule id="100145" level="12" frequency="3" timeframe="300">
    <if_matched_group>sensitive_route</if_matched_group>
    <same_source_ip />
    <description>TaskFlow: several sensitive endpoints probed from the same IP (reconnaissance)</description>
    <mitre>
      <id>T1595.003</id>
    </mitre>
    <group>attack,recon,</group>
  </rule>

</group>
