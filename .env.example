# Copy this file to .env and replace the placeholders.
# docker compose refuses to start if these variables are missing.

POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://postgres:replace_me@postgres:5432/taskflow?schema=public
JWT_SECRET=replace_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost
NODE_ENV=development
