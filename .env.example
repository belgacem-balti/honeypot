# Copy this file to .env (never committed: .env is in .gitignore) and fill in every
# empty value. Used by docker compose and by scripts/create-k8s-secrets.sh.
# Generate strong values with:  openssl rand -base64 32

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=taskflow
# docker compose only (Kubernetes URLs are built by the script). Put the same
# password here; URL-encode it if it contains + / or = (base64 output).
DATABASE_URL=

# --- Server ---
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
CLIENT_URL=http://localhost
NODE_ENV=development

# --- Threat intelligence / AI (optional: leave empty if unused; lookups then fail
#     and the security status endpoint reports them as disabled) ---
GROQ_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=
