# ──────────────────────────────────────────────────────────────────────────────
# TaskFlow — Environment Variables
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Primary shard (used when SHARD_COUNT=1)
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/taskflow"

# Horizontal sharding (set SHARD_COUNT > 1 and add matching SHARD_N URLs)
SHARD_COUNT=1
DATABASE_URL_SHARD_0="postgresql://postgres:change_me@localhost:5432/taskflow"
DATABASE_URL_SHARD_1="postgresql://postgres:change_me@localhost:5433/taskflow"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace_with_a_strong_random_secret"
JWT_EXPIRES_IN="7d"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"

# Role: "api" | "worker" | "all"  (docker-compose sets this per container)
NODE_ROLE="all"

# ── Rate limiting ────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=50

# ── Cache (Redis) ────────────────────────────────────────────────────────────
# Leave empty to use the in-process fallback Map
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=60

# ── Message Queue (RabbitMQ) ──────────────────────────────────────────────────
# Leave empty to use synchronous inline dispatch
RABBITMQ_URL="amqp://guest:change_me@localhost:5672"

# ── Scaling (informational — read by /api/system/status) ─────────────────────
MIN_REPLICAS=2
MAX_REPLICAS=8
CPU_TARGET_PERCENT=70
MEMORY_REQUEST="128Mi"
MEMORY_LIMIT="512Mi"
CPU_REQUEST="100m"
CPU_LIMIT="500m"
LOAD_BALANCER_ALGORITHM="least_conn"
