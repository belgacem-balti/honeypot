# Database Configuration
# PostgreSQL connection string with format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:your_password_here@postgres:5432/taskflow?schema=public

# JWT Authentication
# Secret key for signing JWT tokens - use a strong random string in production
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# JWT token expiration time (examples: 1h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Server Configuration
# Port on which the server will listen
PORT=5000

# Client URL for CORS configuration
CLIENT_URL=http://localhost

# Node environment (development, production, test)
NODE_ENV=production
