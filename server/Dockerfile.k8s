# Kubernetes image for the TaskFlow decoy API (see k8s/minikube/README.md).
# The docker-compose path keeps using ./Dockerfile.

FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402

WORKDIR /app

# openssl for the Prisma engines, tini so SIGTERM reaches node (graceful pod shutdown)
RUN apk add --no-cache openssl tini

# Production dependencies only, plus the Prisma CLI (pinned to the lockfile version)
# so the initContainer can run `prisma migrate deploy`.
COPY package.json package-lock.json ./
COPY prisma ./prisma/
RUN npm ci --omit=dev \
 && npm install --no-save --omit=dev prisma@5.22.0 \
 && npm cache clean --force

COPY . .

RUN npx prisma generate

ENV NODE_ENV=production \
    CHECKPOINT_DISABLE=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1

# Numeric UID so Kubernetes can verify runAsNonRoot (uid 1000 = "node")
USER 1000

EXPOSE 5000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "server.js"]
