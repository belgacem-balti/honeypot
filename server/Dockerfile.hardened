# Multi-stage build for hardened production server image
# Builder stage: install all dependencies and generate Prisma client
FROM node:20-alpine AS builder

WORKDIR /app

# Install openssl for Prisma engine compatibility
RUN apk add --no-cache openssl

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including dev dependencies for Prisma generate)
# Note: Using npm install instead of npm ci due to intentional package mismatches in honeypot
RUN npm install

# Generate Prisma Client
RUN npx prisma generate

# Production stage: minimal runtime with only production dependencies
FROM node:20-alpine

# Install dumb-init for proper signal handling
RUN apk add --no-cache dumb-init openssl

WORKDIR /app

# Create non-root user (nodejs) with UID 1001
RUN addgroup -g 1001 nodejs && \
    adduser -u 1001 -G nodejs -s /bin/sh -D nodejs

# Copy package files
COPY package*.json ./
COPY prisma ./prisma/

# Install only production dependencies
# Note: Using npm install instead of npm ci due to intentional package mismatches in honeypot
RUN npm install --only=production

# Copy Prisma client from builder stage
COPY --from=builder /app/node_modules/.prisma /app/node_modules/.prisma

# Copy application source
COPY --chown=nodejs:nodejs . .

# Switch to non-root user
USER nodejs

EXPOSE 5000

# Health check using Node.js built-in http module
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/health', (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1));"

# Use dumb-init to handle signals properly
# Note: Migrations should be run separately, not in CMD
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "server.js"]
