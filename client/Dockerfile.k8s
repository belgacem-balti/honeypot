# Kubernetes image for the TaskFlow decoy frontend (see k8s/minikube/README.md).
# The docker-compose path keeps using ./Dockerfile.

# Build stage
FROM node:22.23.3-alpine3.24@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# Production stage: non-root nginx listening on 8080.
# The nginx server config is provided by the k8s ConfigMap (k8s/minikube/client/nginx-configmap.yaml).
FROM nginxinc/nginx-unprivileged:1.30.5-alpine3.24@sha256:56b8272e43a0525f67aed68d1e0794a712d10e3e45a563e118e9a77c817e6f86

COPY --from=build /app/dist /usr/share/nginx/html

USER 101

EXPOSE 8080
