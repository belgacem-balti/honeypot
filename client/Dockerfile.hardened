# Multi-stage build for hardened production client image
# Builder stage: build React application with Vite
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
# Note: Using npm install instead of npm ci due to intentional package mismatches in honeypot
RUN npm install

# Copy application source
COPY . .

# Build application
RUN npm run build

# Production stage: nginx with security hardening
FROM nginx:1.25-alpine

# Install dumb-init and wget for health checks
RUN apk add --no-cache dumb-init wget

# Copy built application from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy hardened nginx configuration
COPY nginx.conf.hardened /etc/nginx/conf.d/default.conf

# Remove default nginx config if present
RUN rm -f /etc/nginx/conf.d/default.conf.default

EXPOSE 80

# Health check using wget on localhost
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Use dumb-init to handle signals properly
ENTRYPOINT ["dumb-init", "--"]
CMD ["nginx", "-g", "daemon off;"]
